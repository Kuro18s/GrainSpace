# Sao chép file này thành .env.local rồi điền giá trị thật.
# KHÔNG commit .env.local lên GitHub.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth.js / Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Payload backend / Figma Make (điền giá trị do dự án cung cấp)
FIGMA_CONTENT_API_URL=
FIGMA_CONTENT_API_CONTENT_SYSTEM_ID=
FIGMA_OAUTH_CLIENT_ID=

# Chỉ dùng trong môi trường preview nếu được cung cấp
# FIGMA_PUBLIC_URL=
# FIGMA_PREVIEW_OAUTH_REDIRECT_URI=
# FIGMA_PREVIEW_OAUTH_STATE_PREFIX=
