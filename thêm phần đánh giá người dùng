                                <h4 class="text-xs font-bold text-white">Xác nhận lịch chụp thành công</h4>
                                <p class="text-[10px] text-gray-400 mt-0.5">Lịch chụp với Alex Nguyễn đã được chấp nhận.</p>
                                <span class="text-[9px] text-gray-500 mt-1 block">2 giờ trước</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        // 6. Profile Screen
        function renderProfileScreen() {
            return `
                <div class="px-4 space-y-4 pt-2">
                    <div class="text-center pt-2 space-y-2">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150" class="w-16 h-16 rounded-full mx-auto border-2 border-brand-500 object-cover" />
                        <div>
                            <h3 class="text-xs font-bold text-white">Nguyễn Văn A</h3>
                            <p class="text-[10px] text-gray-400">khachhang@gmail.com</p>
                        </div>
                    </div>

                    <div class="bg-dark-800 rounded-2xl border border-gray-800 divide-y divide-gray-800/80">
                        <div class="p-3 flex items-center justify-between text-xs text-gray-300">
                            <span class="flex items-center space-x-2"><i class="fa-solid fa-clock-rotate-left text-brand-400"></i><span>Lịch sử đặt lịch</span></span>
                            <i class="fa-solid fa-chevron-right text-gray-600 text-[10px]"></i>
                        </div>
                        <div class="p-3 flex items-center justify-between text-xs text-gray-300">
                            <span class="flex items-center space-x-2"><i class="fa-solid fa-star text-amber-400"></i><span>Đánh giá của tôi</span></span>
                            <i class="fa-solid fa-chevron-right text-gray-600 text-[10px]"></i>
                        </div>
                        <div class="p-3 flex items-center justify-between text-xs text-gray-300">
                            <span class="flex items-center space-x-2"><i class="fa-solid fa-heart text-rose-400"></i><span>Nhiếp ảnh gia yêu thích</span></span>
                            <i class="fa-solid fa-chevron-right text-gray-600 text-[10px]"></i>
                        </div>
                    </div>
                </div>
            `;
        }

        // Interactive Handlers
        function handleSelectCategory(cat) {
            state.selectedCategory = cat;
            renderMobileScreen();
        }

        function handleSearch(val) {
            state.searchQuery = val;
            renderMobileScreen();
        }

        function openPhotographerDetail(id) {
            state.selectedPhotographer = mockPhotographers.find(p => p.id === id);
            state.currentTab = 'detail';
            renderMobileScreen();
        }

        function openBookingForm() {
            state.currentTab = 'booking';
            renderMobileScreen();
        }

        function setHours(h) {
            state.bookingHours = h;
            renderMobileScreen();
        }

        function confirmBooking() {
            const p = state.selectedPhotographer;
            const newBooking = {
                id: `BK-${Math.floor(1000 + Math.random() * 9000)}`,
                photographerName: p.name,
                date: state.bookingDate,
                timeSlot: `${state.bookingTime} - ${state.bookingHours}h`,
                totalPrice: p.pricePerHour * state.bookingHours,
                status: 'Chờ xác nhận'
            };
            state.myBookings.unshift(newBooking);
            navToMobileTab('schedule');
        }

        function copyCode() {
            const codeText = document.getElementById('dart-code-block').innerText;
            navigator.clipboard.writeText(codeText);
            const btnText = document.getElementById('copy-btn-text');
            btnText.innerText = 'Đã sao chép!';
            setTimeout(() => {
                btnText.innerText = 'Sao chép Mã Nguồn Dart';
            }, 2000);
        }

        // Init App
        window.onload = function() {
            renderMobileScreen();
        };
    </script>
</body>
</html>
